{
  "name": "internconnect-ai",
  "version": "1.0.0",
  "description": "InternConnect AI Monorepo - AI-Powered Internship Discovery Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/server.js",
    "install:client": "npm --prefix client install",
    "install:server": "npm --prefix server install",
    "postinstall": "npm run install:client && npm run install:server"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.0"
  }
}
